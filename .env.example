# Secreto para firmar los JWT (usa un valor largo y aleatorio: openssl rand -hex 32)
JWT_SECRET=cambia-esto

# URL pública del frontend, permitida por CORS (varias separadas por coma). Vacío = cualquier origen
CORS_ORIGIN=https://app.ejemplo.com

# URL pública de la API, incluyendo /api. Se incrusta en el build del frontend
VITE_API_BASE_URL=https://api.ejemplo.com/api
